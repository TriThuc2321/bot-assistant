# Required. API_KEY is accepted as an alias.
OPENAI_API_KEY=
API_KEY=

# Vector store: set an ID, or leave empty to find-or-create by name.
VECTOR_STORE_ID=
VECTOR_STORE_NAME=optibot-kb

# Zendesk Help Center source
ZENDESK_BASE_URL=https://support.optisigns.com
ZENDESK_LOCALE=en-us

# 0 = all articles; set a small number for local testing.
MAX_ARTICLES=0

# Chunking (overlap must be <= half of chunk size)
CHUNK_SIZE_TOKENS=800
CHUNK_OVERLAP_TOKENS=200

OUTPUT_DIR=articles
DRY_RUN=false
LOG_LEVEL=INFO
